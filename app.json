{
  "expo": {
    "name": "GrindZone",
    "slug": "grindzone",
    "scheme": "grindzone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#09090A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.grindzone.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#09090A"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c65f044a-aba0-4cbd-9d20-df99fe481502"
      }
    },
    "owner": "azatkabulov",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c65f044a-aba0-4cbd-9d20-df99fe481502"
    }
  }
}
